# ── reasoning: OpenRouter (agent, digests, judging) ──
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── retrieval: Gemini (embeddings only) ──
# The corpus is vectorized with gemini-embedding-001, and vectors from another
# model are not comparable, so embeddings stay here.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Provider for reasoning: openrouter | gemini
# Unset = openrouter if OPENROUTER_API_KEY exists, else gemini.
HINDSIGHT_LLM_PROVIDER=openrouter

# Models (defaults shown)
HINDSIGHT_CHAT_MODEL=openai/gpt-5.2
HINDSIGHT_FAST_MODEL=openai/gpt-5-mini
HINDSIGHT_EMBED_MODEL=gemini-embedding-001

# Optional: fact-check crossref via Google Fact Check Tools API
# (aggregates PolitiFact, Snopes, AFP…). Free key: enable "Fact Check Tools API"
# in console.cloud.google.com
GOOGLE_FACTCHECK_API_KEY=

# Optional: visual layer — an 8kEdu deployment for keyframe thumbnails and
# frame-level "what's on screen" answers (https://github.com/8k-Edu/8kEdu)
EDU8K_URL=
