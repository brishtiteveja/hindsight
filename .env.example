# Google AI Studio key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Models (defaults shown)
HINDSIGHT_CHAT_MODEL=gemini-3-flash-preview
HINDSIGHT_EMBED_MODEL=gemini-embedding-001

# Optional: fact-check crossref via Google Fact Check Tools API
# (aggregates PolitiFact, Snopes, AFP…). Free key: enable "Fact Check Tools API"
# in console.cloud.google.com
GOOGLE_FACTCHECK_API_KEY=

# Optional: visual layer — an 8kEdu deployment for keyframe thumbnails and
# frame-level "what's on screen" answers (https://github.com/8k-Edu/8kEdu)
EDU8K_URL=
